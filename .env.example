# Veyra AI — Environment configuration (copy to .env and fill values)
# Never commit .env with real secrets.

NODE_ENV=development
PORT=3000

# Public URL of the deployed app (used for OpenRouter referer, share links, CORS)
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# REQUIRED in production — random secrets
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=
# 64 hex chars (32 bytes) for AES-256-GCM of API keys
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# First-run admin (only used when store is empty)
ADMIN_EMAIL=admin@veyra.local
# Leave empty to auto-generate a one-time password printed to server logs
ADMIN_PASSWORD=

# Data directory (default: ./data/store)
VEYRA_DATA_DIR=

# Optional: SMTP for developer feedback emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DEVELOPER_EMAIL=nidalwatfa99@gmail.com

# Optional fallback keys (prefer storing via UI — encrypted per organization)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
